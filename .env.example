# Copy to .env for local development. On a host, set these as environment variables instead.
# NEVER commit .env - it holds the API key.

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6b03285a00183e69a96f
# Server API key (Appwrite console > Overview > Integrations > API keys).
# Scopes: users.read, users.write, sessions.write, databases.read, databases.write,
#         tables.read, tables.write, rows.read, rows.write, files.read, files.write, buckets.read
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=coursefile
APPWRITE_BUCKET_ID=course-files

# Local development over plain http only (lets the login cookie work without https). Leave unset in production.
# CFG_COOKIE_SECURE_AUTO=0
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Frontend hosted on Appwrite Sites (different origin): allow it to call this API.
# CFG_ALLOWED_ORIGINS=https://<your-site>.appwrite.network
# Use "lax" if the site and API share a registrable domain (e.g. app.x.com + api.x.com); otherwise leave default.
# CFG_COOKIE_SAMESITE=none
